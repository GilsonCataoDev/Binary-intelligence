{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary-intelligence-ai.local/contracts/candle-batch.v1.schema.json",
  "title": "CandleBatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "candles"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\." },
    "candles": {
      "type": "array",
      "items": { "$ref": "#/$defs/candle" }
    }
  },
  "$defs": {
    "positiveDecimal": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
      ]
    },
    "nonNegativeDecimal": {
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
      ]
    },
    "candle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "timeframe", "open_time", "close_time", "open", "high", "low", "close", "volume", "source", "ingested_at"],
      "properties": {
        "asset": { "type": "string", "minLength": 1, "maxLength": 40 },
        "timeframe": { "enum": ["1m", "5m"] },
        "open_time": { "type": "string", "format": "date-time" },
        "close_time": { "type": "string", "format": "date-time" },
        "open": { "$ref": "#/$defs/positiveDecimal" },
        "high": { "$ref": "#/$defs/positiveDecimal" },
        "low": { "$ref": "#/$defs/positiveDecimal" },
        "close": { "$ref": "#/$defs/positiveDecimal" },
        "volume": { "anyOf": [{ "$ref": "#/$defs/nonNegativeDecimal" }, { "type": "null" }] },
        "source": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ingested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
