{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary-intelligence-ai.local/schemas/news-context.v1.schema.json",
  "title": "NewsContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "availability", "as_of", "events", "limitation"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^1\\."},
    "availability": {"enum": ["available", "degraded", "unavailable"]},
    "as_of": {"type": "string", "format": "date-time"},
    "limitation": {"type": ["string", "null"]},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source", "source_event_id", "headline", "event_type", "published_at", "event_at",
          "affected_assets", "reported_impact", "ingested_at", "delayed", "evidence"
        ],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "source_event_id": {"type": "string", "minLength": 1},
          "headline": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "minLength": 1},
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "event_at": {"type": ["string", "null"], "format": "date-time"},
          "affected_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reported_impact": {"enum": ["unknown", "low", "medium", "high"]},
          "ingested_at": {"type": "string", "format": "date-time"},
          "delayed": {"type": "boolean"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
