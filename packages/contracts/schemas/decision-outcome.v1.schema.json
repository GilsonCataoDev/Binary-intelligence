{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary-intelligence-ai.local/schemas/decision-outcome.v1.schema.json",
  "title": "DecisionOutcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "payout", "probability_used", "expected_value", "break_even_probability", "reasons"],
  "properties": {
    "decision": {"enum": ["CALL", "PUT", "ABSTAIN"]},
    "payout": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "probability_used": {"type": "number", "minimum": 0, "maximum": 1},
    "expected_value": {"type": ["number", "null"]},
    "break_even_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
