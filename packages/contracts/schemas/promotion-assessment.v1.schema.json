{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary-intelligence-ai.local/contracts/promotion-assessment.v1.schema.json",
  "title": "PromotionAssessmentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline", "candidate", "approved", "holdout_confirmed", "brier_improvement", "fold_win_rate", "expected_calibration_error", "reasons"],
  "properties": {
    "baseline": { "type": "string", "minLength": 1 },
    "candidate": { "type": "string", "minLength": 1 },
    "approved": { "const": false },
    "holdout_confirmed": { "const": false },
    "brier_improvement": { "type": ["number", "null"] },
    "fold_win_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "expected_calibration_error": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
